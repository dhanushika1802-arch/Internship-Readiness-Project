# Root-level gitignore for ReadyUp AI monorepo

# Python backend
backend/venv/
backend/.venv/
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/database.db
backend/uploads/

# Node/React frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local

# OS & editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.log
